*key = 73
*value = "Once an 'X' spots his mark\nHe'll dash around the cove\nPast storm, abyss, and shark\nStraight to a treasure trove"
*key = 74
*value = "If a heart on high's your wish\nTo keep you in the loop\nSome odd aggressive fish\nMust first be schooled in hoop"
*key = 75
*value = "Beacon laying in waste\nAppears your only hope\nTo reach goal highly placed\nIt first must telescope"
*key = 76
*value = "A buzzing watercraft\nAwaits for you to race\nSo stay true to a path\n And end it in first place"
*key = 77
*value = "Throughout a sunken lair\nFloat Soul Jars of the deep\nThe scarce pockets of air\nSustain you in the keep"
