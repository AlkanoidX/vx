*value = "A tower holds a heart\nThat seems so simply freed\nAlthough skill plays a part\nIt's gravity you need"
*key = 80
*value = "Once you've unlocked the gift\nOf darting through the waves\nPerhaps you'll catch the drift \nOf the darting rays"
*key = 81
*value = "To each watery tower\nYou may get around\nGrab a gift of power\nWhen their answer is found"
