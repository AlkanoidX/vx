*key = 33
*value = "Progressive scan was activated."
*key = 34
*value = "Progressive scan was not activated."
*key = 35
*value = "You are now in\nprogressive scan video mode.\n\nPlease press continue\nto proceed in this mode,\nor cancel to return\nto interlaced mode."
*key = 36
*value = "continue"
