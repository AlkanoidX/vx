*value = "Warp to Shadow Realm?"
*key = 36
*value = "Stay off the floor...unless you want to be eaten!"
*key = 37
*value = "If you end up on the floor...get to a vent and get a lift back up, quick!"
*key = 38
*value = "Too Slow!!!"
*key = 39
*value = "Why must your INNER DEMONS haunt you? Show them your skills by sending them down to their doom!"
*key = 40
*value = "It is time to face your INNER DEMONS in a game of speed! If you start to fall behind, use your fighting skills to even the score!"
*key = 41
*value = "Your INNER DEMONS are getting stronger and they are out for REVENGE! It will take the POWERS of the ELEMENTS to defeat them this time!"
*key = 42
*value = "Now you have more than your INNER DEMONS to worry about! There is a CURSE loose! Watch out when it lands!"
