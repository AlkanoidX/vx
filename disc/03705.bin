$\Data\Text\ADDENDUM2.txm*key = 0
*value = "Riservato"
*key = 1
*value = "Benvenuto a Timberdale, Vexx! Sparsi per questa terra troverai Quattro prezioni CUORI DI WRAITH. Devi raccoglierli tutti per dare energia al PORTALE CENTRALE e poter accedere cos&igrave; alla prossima terra."
*key = 2
*value = "Il primo CUORE DI WRAITH si trova qui. Devi raggiungere la cima dell'Albero Gigante per impossessartene."
*key = 3
*value = "Combatti contro il boss del Sumo Gigante per ottenere il suo CUORE DI WRAITH."
*key = 4
*value = "Scala le Rocce Ribollenti per ottenere questo CUORE DI WRAITH."
*key = 5
*value = "fatti strada tra gli ostacoli per raggiungere le cascate dove si trova questo CUORE DI WRAITH."
*key = 6
*value = "Vexx, raccogli un CUORE DI WRAITH e io potr&ograve; incontrarti dall'altro lato del PORTALE CENTRALE. Buona fortuna, amico mio!"
*key = 7
*value = "Le MURA SCALABILI sono segnate da marcatori unici. <pause>SALTA su un MURO SCALABILE per dare inizio all'arrampicata. <pause>Muoviti verso l'ALTO con la LEVETTA SINISTRA e premi il pulsante di SALTO per scalare le mura pi&ugrave; rapidamente. <pause>Rilascia il pulsante di SALTO per afferrarti al muro nel corso della scalata. <pause>Premi il pulsante di SALTO senza usare la levetta sinistra per lasciarti cadere dal muro. <pause>Premi il pulsante di ATTACCO per scendere dal muro."
*key = 8
*value = "Muovi la LEVETTA DESTRA per muovere la visuale attorno a Vexx. <pause>Spingi in avanti la LEVETTA DESTRA per avvicinare lo zoom."
*key = 9
*value = "Premi START in qualsiasi momento per visualizzare gli indizi per i CUORI DI WRAITH."
*key = 10
*value = "Esegui un SALTO POTENZIATO per raggiungere altezze maggiori. <pause>Quando sei fermo, tira e spingi il GRILLETTO SINISTRO per abbassarti, quindi premi il pulsante di SALTO."
*key = 11
*value = "Esegui un ATTACCO UPPERCUT per sbalzare via i nemici. <pause>Quando sei fermo, tira e spingi il GRILLETTO SINISTRO per abbassarti, quindi premi il pulsante di ATTACCO."
*key = 12
*value = "Esegui un SALTO LUNGO per raggiungere distanze maggiori. Mentre corri, premi il GRILLETTO SINISTRO per abbassarti, quindi premi subito il pulsante di SALTO. <pause>La sincronizzazione &egrave; tutto!"
*key = 13
*value = "Sconfiggi il Sumo Gigante e gettalo fuori dal ring 3 volte per vincere. <pause>Fai attenzione al suo ATTACCO POSSENTE!"
*key = 14
*value = "Esegui degli AIR JUGGLE consecutive per ottenere dei bonus extra."
*key = 15
*value = "Ben fatto, Vexx! Hai raccolto 100 BOLLE DI SANGUE. Combinando la loro energia otterrai questo CUORE DI WRAITH."
*key = 16
*value = "Vexx"
*key = 17
*value = "Sumo"
*key = 18
*value = "Ben fatto, Vexx! Hai trovato I livelli segreti del Portale della Meridiana. Trova il CUORE DI WRAITH nascosto all'interno."
*key = 19
*value = "Ben fatto, Vexx! Hai liberato 6 spiriti Astani dale loro GIARE DELLE ANIME. Ecco il  CUORE DI WRAITH."
*key = 20
*value = "Ben fatto, Vexx! Hai raccolto 6 SIGILLI. Ecco il  CUORE DI WRAITH."
*key = 21
*value = "Hai appena trovato uno dei 6 SIGILLI. Trovali tutti per scoprire il CUORE DI WRAITH."
*key = 22
*value = " Oltre l'oscura ora. <pause>ti attende un misterioso nemico <pause> per sfruttare ogni tuo potere, <pause>per batterti in una dura gara."
*key = 0
*value = "Riservato"
*key = 1
*value = "Se cadi da una certa altezza, usa un calcio affilato per evitare di farti male atterrando."
*key = 2
*value = "Se vuoi tornare su una via pi&ugrave; semplice, scendi al livello inferiore e usa il teletrasporto."
*key = 3
*value = "Quando attacchi i nemici, cerca di usare i Juggle per aumentare le tue possibilit&agrave; di riuscita, la tua salute e liberare degli uomini."
*key = 4
*value = "Il MagnaSliph &egrave; una letale creatura del deserto. Usa il montacarichi per evitare di venire assorbito da questa enorme bestia."
*key = 5
*value = "Si dice che non tutti i nemici abbiano intenzioni malvagie. Aspetta qui e vedrai."
*key = 6
*value = "CONGRATULAZIONI! Hai ottenuto il bonus Aereo! Ora potrai volare per brevi tratti."
*key = 7
*value = "Aiutami a ripulire questo luogo, per favore!"
*key = 8
*value = "Grazie! Vieni qui, ho qualcosa per te."
*key = 9
*value = "[disponibile]"
*key = 10
*value = "[disponibile]"
*key = 0
*value = "Riservato"
*key = 1
*value = "Non andrai molto lontano su questo pavimento cos&igrave; scivoloso, Vexx... <pause> ad eccezione, forse, di una fornace!"
*key = 2
*value = "hai vinto!"
*key = 3
*value = "Troppo lento, riprova!"
*key = 4
*value = "Via!"
*key = 5
*value = "[disponibile]"
*key = 6
*value = "[disponibile]"
*key = 7
*value = "[disponibile]"
*key = 8
*value = "[disponibile]"
*key = 9
*value = "[disponibile]"
*key = 10
*value = "[disponibile]"
*key = 0
*value = "Riservato"
*key = 1
*value = "Non disponibile"
*key = 2
*value = "Premi X per accedere al mondo della Foresta o A per annullare."
*key = 3
*value = "CONGRATULAZIONI! Hai sbloccato una nuova area con questi 5 cuori."
*key = 4
*value = "Siamo rinchiusi in questa prigione d'ora. Se non ci liberi, verremo allontanati per sempre!"
*key = 5
*value = "Arrgh! Non c'&egrave; oro qui!"
*key = 6
*value = "Premi il tasto giusto per sbloccare ogni serratura."
*key = 7
*value = "Premi il tasto giusto per sbloccare la serratura 2."
*key = 8
*value = "Premi il tasto giusto per sbloccare la serratura 3."
*key = 9
*value = "Combinazione errata."
*key = 10
*value = "Sono pronto per dei bei soldoni! Muoviti con quella combinazione."
*key = 11
*value = "Oh, che c'&egrave; nella scatola?!?"
*key = 12
*value = "SEI grande!"
*key = 13
*value = "Ladro! Ti odiamo. Ti odieremo per sempre!"
*key = 14
*value = "Fammi vedere, dai, fammi vedere quello che sai fare."
*key = 15
*value = "Anche tu puoi passare dalle isole superiori a quelle inferiori grazie allE tubature. Baster&agrave; saltare nel buco."
*key = 16
*value = "Non potrai accedere al faro fino a quando non sar&agrave; completamente libero."
*key = 17
*value = "Attenzione, prima di avvicinarti all'Oscillatore quantico-balistico elettroconduttore: <pause>potresti indurre dei fenomeni di interferenza quantica non desiderati nelle nanostrutture balistiche. <pause>In altre parole, premi un tasto per disattivare il raggio."
*key = 18
*value = "Nelle bolle di quest'area sono intrappolate sei giare delle anime."
*key = 19
*value = "Il punto debole del Sumo &egrave; nel suo lato posteriore."
*key = 20
*value = "Spesso correre non &egrave; il modo pi&ugrave; veloce per coprire delle distanze."
*key = 21
*value = "Cerca le bolle pi&ugrave; grosse per ripristinare I tuoi livelli di ossigeno quando sei sottacqua."
*key = 22
*value = "Hai trovato un cuore di Wraith!"
*key = 0
*value = "Riservato"
*key = 1
*value = "Sei davvero lento come sembri? Facciamo una gara e vediamo!  <3> Si  <2> No <respond 2 3>"
*key = 2
*value = "Questo &egrave; ci&ograve; che penso: non mi batterai mai!"
*key = 3
*value = "Vedo che sei al traguardo!"
*key = 4
*value = "Da qui potrai accedere alla Piramide."
*key = 5
*value = "Wow! Sei pi&ugrave; veloce di quanto pensassi. Ecco la tua ricompensa!"
