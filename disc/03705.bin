*value = "Vexx"
*key = 9
*value = "Schatten-Vexx"
*key = 10
*value = "Vexx gewinnt!"
*key = 11
*value = "Runde vorbei"
*key = 12
*value = "Sammle 100 Ringe, um zu GEWINNEN!"
*key = 13
*value = "Sammle 200 Ringe, um zu GEWINNEN!"
*key = 14
*value = "Besiege deine\nINNEREN D&Auml;MONEN\n3 Mal, um zu gewinnen!"
*key = 15
*value = "Besiege deine\nINNEREN D&Auml;MONEN\n6 Mal, um zu gewinnen!"
*key = 16
*value = "K&Auml;MPFE bis zum TOD!"
*key = 17
*value = "BLITZE"
*key = 18
*value = "Siehst du den SCHADENSMESSER?\nJe HELLER er leuchtet,\ndesto n&auml;her sind deine Feinde\ndem TOD!"
*key = 19
*value = "/75"
*key = 20
*value = "VAKUUM"
*key = 21
*value = "WIND"
*key = 22
*value = "HEMMRING"
*key = 23
*value = "DIEBESRING"
*key = 24
*value = "GABENRING"
*key = 25
*value = "Bist du bereit, gegen deine INNEREN D&Auml;MONEN zu K&Auml;MPFEN? Denke daran: Sie wissen genau, was du tust!"
*key = 26
*value = "Deine INNEREN D&Auml;MONEN werden st&auml;rker und d&uuml;rsten nach RACHE! Diesmal brauchst du die KR&Auml;FTE der ELEMENTE, um sie zu besiegen!"
*key = 27
*value = "Es ist Zeit, in einem rasanten Spiel gegen deine INNEREN D&Auml;MONEN anzutreten!"
*key = 28
*value = "Diesmal sind deine INNEREN D&Auml;MONEN sehr viel m&auml;chtiger, und die Ringe sind nicht mehr so freundlich! Dieser besondere Ring, der dir einst eine GABE brachte, hat sich nun in einen DIEB verwandelt!"
*key = 29
*value = "Warum m&uuml;ssen deine INNEREN D&Auml;MONEN dich fortw&auml;hrend verfolgen? Zeig ihnen deine Kr&auml;fte, indem du sie ihrer Vernichtung entgegenf&uuml;hrst!"
*key = 30
*value = "Nun hast du es mit Schlimmerem zu tun als nur deinen INNEREN D&Auml;MONEN! Ein FLUCH wurde losgelassen!\nDadurch wird alles\nsehr viel schwieriger.\nGib Acht, wenn er landet!"
*key = 31
*value = "Das ist deine Chance!\nGIB deinen INNEREN D&Auml;MONEN den REST,\nsolange sie am Boden liegen!"
*key = 32
