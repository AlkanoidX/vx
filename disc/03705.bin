*value = "Die Optionen von\nMemory Card (PS2)\nin MEMORY CARD Steckplatz 1 werden geladen.\nBitte Memory\nCard (PS2) nicht entfernen,\nKonsole nicht zur&uuml;cksetzen\noder ausschalten."
*key = 8
*value = "Memory Card (PS2) in\nMEMORY CARD-\nSteckplatz 1\nist nicht formatiert.\n\nM&ouml;chtest du\nsie formatieren?"
*key = 9
*value = "Mit Speichervorgang fortfahren?"
*key = 10
*value = "Ladevorgang fehlgeschlagen."
*key = 11
*value = "Speichervorgang fehlgeschlagen."
*key = 12
*value = "M&ouml;chtest du die\nzuvor gespeicherten\nOptionen &uuml;berschreiben?"
*key = 13
*value = "Beim Laden der Optionen ist ein Fehler aufgetreten."
*key = 14
*value = "Fortfahren ohne Speichern?"
