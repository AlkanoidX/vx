*value = "Anillo Ladr&oacute;n"
*key = 24
*value = "Anillo de regalo"
*key = 25
*value = "&iquest;Est&aacute;s preparado para LUCHAR contra tus DEMONIOS INTERIORES? &iexcl;Recuerda que saben cada uno de tus movimientos!"
*key = 26
*value = "&iexcl;Tus DEMONIOS INTERIORES se est&aacute;n haciendo m&aacute;s fuertes y buscan VENGANZA! &iexcl;Necesitar&aacute;s la FUERZA de los ELEMENTOS para vencerles!"
