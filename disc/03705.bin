*value = "Cancellazione ultimata "
*key = 19
*value = "Cancellazione in corso"
*key = 0
*value = "Riservato"
*key = 1
*value = "Posso parlarti cos&igrave;."
*key = 2
*value = "Prosegui fuori. Posso metterti sulla giusta strada."
*key = 3
*value = "I Wraith sono come gli scarafaggi: pressoch&eacute; impossibili da eliminare.  Anche se ne uccidi uno, il suo cuore non morir&agrave; mai."
*key = 4
*value = "L'unico modo che hai per fermare Yabu &egrave; raggiungere la Landspire. Per arrivare l&agrave;, dovrai riattivare gli Antichi portali."
*key = 5
*value = "Prosegui e inserisci il cuore nel portale di fronte a te."
*key = 6
*value = "Molto tempo fa, i Wraith prosciugarono l'energia del sistema di portali, non riuscendo a resistere al piacere di nutrirsi di essa. I cuori sono ancora ricchi di energia e possono essere usati per attivare i portali."
*key = 7
*value = "Quando ti avvicini a un portale e ne attivi il meccanismo, vedrai apparire un quadrante. Interessante, vero? Quegli Astani sapevano il fatto loro! Bene, ecco quello che bisogna fare: aprire un portale per un altro mondo e fare fuori tutti!"
*key = 8
*value = "Una volta inseriti abbastanza cuori nel portale, sarai in grado di accedere a nuove mondi."
*key = 9
*value = "Fai in fretta! Ogni momento che passa permette a quei malvagi di avvicinarsi sempre pi&ugrave; alla riapertura del portale che conduce al loro mondo oscuro!"
*key = 10
*value = "Non tutti i cuori di Wraith sono sopravvissuti intatti al cataclisma.  Alcuni esplosero e furono cos&igrave; disseminati in giro. Dovrai raccoglierli e ricomporre i cuori prima di poterli usare!"
*key = 11
*value = "Gli Astani War Talons che indossi possono compiere eccezionali prodigi. Non voglio rovinerti la sorpresa, ma tu cerca le rune elementali che appartengono ai Talon. Solo cos&igrave; potrai sfruttare appieno la loro potenza per brevi intervalli di tempo."
*key = 12
*value = "Tieni sempre d'occhio le rune! Yabu le ha prese e nascoste bene."
*key = 13
*value = "Stai attento, gli Shadowraith sanno cambiare la propria forma esteriore. Non ti fidare di nessuno lungo la tua avventura!"
*key = 14
*value = "Se riesci a raggiungere il sistema di portali e rimetterlo in funzione dopo tutti questi anni, potremo finalmente scoprire se qualcuno &egrave; riuscito a sopravvivere al cataclisma."
*key = 15
*value = "There's not much left of this world. The ancient Astani made a terrible mistake all those years ago when they opened a rift to the shadow realm. They paid for it with their lives"
*key = 16
*value = "Girano voci che gli Antichi Astani vivano ancora in Astara."
*key = 17
*value = "Dovrai trovare le antiche rovine e I siti di sepoltura sparsi per tutta Astara. Se ascolti con attenzione, potrai udire le voci delle persone morte durante il cataclisma e le urla delle loro anime torturate."
*key = 18
*value = "Stai facendo un ottimo lavoro. Mi ricordi tuo padre quando indossava i Talon."
*key = 19
*value = "Quest'area un tempo era molto popolata, ma gli Shadowraith ne prosciugarono tutta l'energia durante la guerra."
*key = 20
*value = "Your father wore the Talons as guardian for years, until Yabu caught him by surprise while he and your mother were sleeping. Guess it's time for payback."
*key = 21
*value = "I tuoi genitori sono seppelliti nella Sala degli Eroi, dove tu rinvenisti dopo l'esplosione."
*key = 22
*value = "Benvenuto a Timberdale, Vexx! Sparsi per questa terra ci sono quattro preziosi cuori di Wraith. Devi trovarli per attivare il Portale centrale e accedere alla prossima terra."
*key = 23
*value = "Il primo cuore di Wraith si trova qui. Devi superare la cima dell'Albero gigante per raccoglierlo."
*key = 24
*value = "Affronta il Giant Sumo per conquistare il cuore di Wraith che egli possiede."
*key = 25
*value = "Scala le Rocce ribollenti per raccogliere questo cuore di Wraith."
*key = 26
*value = "fatti strada attraverso le cascate per raggiungere questo cuore di Wraith."
*key = 27
*value = "Vexx, raccogli uno dei cuori di Wraith e io ti raggiunger&ograve; dall'altro lato del Portale centrale. Buona fortuna, amico mio!"
*key = 28
*value = "Ben fatto, Vexx. Hai raccolto 100 frammenti. Combinando la loro energia hai sprigionato la potenza di questo cuore do Wraith."
