*value = "RELAMPAGO"
*key = 18
*value = "&iquest;Observas el medidor de energ&iacute;a?\n&iexcl;cuanto m&aacute;s brille,\n m&aacute;s cercanos est&aacute;n tus enemigos\nde la MUERTE!"
