*value = "Pulsa X para acceder al Mundo del Bosque o A para cancelar."
*key = 3
*value = "&iexcl;FELICIDADES! Con estos 5 corazones habr&iacute;as desactivado otra zona."
*key = 4
*value = "Vamos tras el bot&iacute;n de ese cofre del tesoro. Si no consigues abrirnoslo, te echaremos a patadas de este agujero!"
*key = 5
*value = "&iexcl;Arrgh! &iexcl;No hay oro en este cofre!"
*key = 6
*value = "Pulsa el bot&oacute;n correcto para desactivar cada cerradura."
*key = 7
*value = "Pulsa el bot&oacute;n correcto para desactivar la cerradura 2."
*key = 8
*value = "Pulsa el bot&oacute;n correcto para desactivar la cerradura 3."
*key = 9
*value = "Combinaci&oacute;n incorrecta."
*key = 10
*value = "&iexcl;Estoy ansioso por conseguir dinero! As&iacute; que date prisa con la combinaci&oacute;n."
*key = 11
*value = "Oh, &iquest;&iexcl;&iquest;qu&eacute; hay en la caja?!?!"
*key = 12
*value = "&iexcl;ERES incre&iacute;ble!"
*key = 13
*value = "&iexcl;Ladr&oacute;n! Lo odiamos. &iexcl;Lo odiaremos siempre!"
*key = 14
*value = "Ens&eacute;&ntilde;ame, ens&eacute;&ntilde;ame, ens&eacute;&ntilde;ame c&oacute;mo haces ese truco."
*key = 15
*value = "T&uacute; tambi&eacute;n puedes viajar entre las islas altas y las islas bajas con la Tecnolog&iacute;ad del Tubo. Simplemente salta dentro del agujero."
*key = 16
*value = "No se puede acceder al faro hasta que se haya expandido totalmente."
*key = 17
*value = "Cuidado, antes de acercarte al Oscilador Electroconductor de Bal&iacute;stica Quantum,<pause>uno debe primeramente inducir un fen&oacute;meno de interferencia quantum an&aacute;logo al efecto electroest&aacute;tico Janda-Ong de las nanoestructuras de bal&iacute;stica. <pause> En resumidas cuentas, pulsa un bot&oacute;n para desactivar el rayo."
*key = 18
*value = "Seis jarras espirituales han quedado atrapadas dentro de las burbujas por toda esta zona."
*key = 19
*value = "La zona d&eacute;bil del luchador de Sumo est&aacute; por atr&aacute;s"
*key = 20
*value = "Correr no es la manera m&aacute;s r&aacute;pida de cubrir terreno."
*key = 21
*value = "Busca grandes burbujas reflectantes para rellenar tu ox&iacute;geno debajo del agua."
*key = 22
*value = "&iexcl;Un Coraz&oacute;n Tenebroso se ha manifestado afuera!"
*key = 0
*value = "Reserved"
*key = 1
*value = "&iquest;Eres tan lento como pareces?,vamos correr para comprobarlo.  <3> Si  <2> No <respond 2 3>"
*key = 2
*value = "Es lo que pensaba, de todas formas &iexcl;nunca me ganar&iacute;as!"
*key = 3
*value = "Te veo en la l&iacute;nea de llegada, si es que llegas tan lejos."
*key = 4
*value = "Este sendero te llevar&aacute; a la entrada de la piramide."
*key = 5
*value = "&iexcl;Guauu! eres m&aacute;s r&aacute;pido de lo que pensaba. Aqu&iacute; est&aacute; tu premio."
