*value = "Riservato"
*key = 1
*value = "Sperduto in un villaggio\ndi metallo, legno e fuoco\nun contorto albero fu saccheggiato\ne un segreto fu svelato."
*key = 2
*value = "I Talon vennero alla luce\nmentre ne stavano frugando la cima,\nsebbene le ricompense siano poche\nlass&ugrave; ove il fiume ribolle."
*key = 3
*value = "Sulle ali di una leggera brezza\nle pietre danzano;\nun premio che dovrai saper conquistare,\nuna tragedia che dovrai saper evitare."
*key = 4
*value = "Un massiccio Sumo crolla,\nla tempesta conduce i suoi artigli\nverso la vittoria; sfuggi alla sua morsa\no sarai per sempre perduto."
*key = 5
*value = "Le anime degli antichi Astani\nsono intrappolate in queste giare.\nPer ottenere ci&ograve; che esse custodiscono\nsfrutta tutte le tue abilit&agrave;."
*key = 6
*value = "Orribili orde rosse\ncercheranno di precederti.\nTroverai aiuto, si narra,\nsolo nel possesso dei cuori."
*key = 7
*value = "Come intrappolato in una resina,\nun cuore giace sospeso\nin un luogo liquefatto.\nLa ricompensa ti attende."
*key = 8
*value = "Un drago perduto nel proprio sonno\nsta a guardia di un prezioso tesoro\celato tra il legno.\nIl silenzio sar&agrave; la tua arma."
*key = 9
*value = "Lass&ugrave;, dovrai andare, tra le cima della foresta\nper trovarne uno.\nLontano dai briganti della foresta,\npotrai conquistare il tuo tesoro."
*key = 10
*value = "Sposta la misteriosa sfera\noltre una particolare giuntura.\nAnche se la ricompensa &egrave; palese\npotresti sempre incappare in qualche trappola."
*key = 11
*value = "Perlustra ogni pertugio\ntra gli alti alberi\nsino a quando non avrai guardato ovunque\ne liberato cos&igrave; le sei anime."
*key = 12
*value = "Tutte quelle blu\nsvolgono la stessa funzione\nmentre quelle di altre tonalit&agrave;\nsi stanno trasformando in un cuore di Wraith."
*key = 13
*value = "I relitti giacciono e\nchiss&agrave; quale mistero essi celano?\nCammina, scopri il segreto:\nAlcuni dovranno essere ricomposti."
*key = 14
*value = "Tra l'immondizia pi&ugrave; nera\nfluttuante in aria:\nsar&agrave; una corsa contro la fortuna o contro l'abilit&agrave;?\nLa ricompensa &egrave; ci&ograve; che cerchi."
*key = 15
*value = "Avrai accesso ai glifi\ne da l&igrave; raggiungerai una radura:\nma una volta giunto a destinazione\nfai attenzione al pavimento, che oscuri segreti nasconde."
*key = 16
*value = "Nel tempio troverai\nun gioco di riunione;\nunisci i migliori tre dello stesso tipo\nper ottenere gli anelli del tempio."
*key = 17
*value = "Tra le mura di un antico tempio\ngiace un oscuro segreto.\nFai ritorno prima del crollo\ne divieni il protagonista della storia."
*key = 18
*value = "Un cuore di Wraith troverai\ne tuo dovrai farlo:\ntrova quelli d'oro\nin queste terre di avventura."
*key = 19
*value = "Una ricompensa riceverai\nse a superare tutti i pericoli riuscirai.\nPresto tutto ti verr&agrave; rivelato,\nma ricorda sempre qual &egrave; la tua missione."
*key = 20
*value = "Dopo aver conquistato le ali\nsaprai raggiungere la cima\ne trovare cos&igrave; l'artefatto magico\nche giace sulla pi&ugrave; aspra sommit&agrave;."
*key = 21
*value = "Il portale sta chiamando, i suoi meridiani\nsegnano il tempo, oltre il passaggio\nti attendono nuove avventure: perdere\nl'occasione sarebbe uno sciocco errore."
*key = 22
*value = "Oltre l'oscura ora\nti attende un misterioso nemico\nper sfruttare ogni tuo potere,\nper batterti in una dura gara."
*key = 23
*value = "In queste misteriose terre\ndovrai affrontare un'ardua prova:\nconquistane sei in questo mondo e scopri\nche non &egrave; stato tutto vano."
*key = 24
*value = "Hai trovato il tuo tesoro\ncelato in questo luogo,\nma se riuscirai a trovarne ancora uno\nla prova sar&agrave; ultimata."
*key = 25
*value = "Oltre il sonno del drago\ndove il tempo pare si sia arrestato\ndovrai muoverti velocemente\nper vincere questa sfida."
*key = 26
*value = "Lo scrigno dell'eterna notte\ncela una terribile domanda.\nSolo con queste tre abilit&agrave; sopravviverai:\nfuoco, agilit&agrave; e discrezione."
*key = 27
*value = "Oltre il sonno del fossile\nuna nave fluttua nell'aria.\nSegui il misterioso sentiero\ne fai uso delle ali per muoverti."
*key = 28
*value = "Trova un tesoro pulsante\ntra le antiche rovine\ne fai sempre attenzione\nperch&eacute; il pericolo &egrave; ovunque."
*key = 29
*value = "Gli spiriti dei dannati\nintrappolati in un eterno dolore\ngiacciono in questo luogo\ntra i propri resti umani."
*key = 30
*value = "Orribili orde rosse\ncercheranno di precederti.\nTroverai aiuto, si narra,\nsolo nel possesso dei cuori."
*key = 31
*value = "Questa vecchia cittadella\normai consumata dal tempo e dalla polvere\ncela losche trappole\nsul tuo cammino verso la cima della torre."
*key = 32
*value = "Il tempio di Nanyk\ngiace sepolto dalla sabbia.\nCerca di trovarne l'accesso\ne compiere cos&igrave; il tuo dovere."
*key = 33
*value = "In una camera segreta\nti attende una dura missione:\nsupera i pericoli\nper ottenere il tuo tesoro."
*key = 34
*value = "Un enigma composto da tre anelli\nti sbarra il cammino.\nSe combattere &egrave; il tuo destino\superare questo pericolo saprai."
*key = 35
*value = "Mentre stai attraversando le mura abbassati\nper trovare le giare delle anime.\nSbaglia un salto e cadrai\nin un baratro senza fine."
*key = 36
*value = "Tutte quelle blu\nsvolgono la stessa funzione\nmentre quelle di altre tonalit&agrave;\nsi stanno trasformando in un cuore di Wraith."
*key = 37
*value = "Un Monaco malato\ndurante la sua meditazione;\nun'orda di nemici\nche deve essere sterminata."
*key = 38
*value = "Otterrai delle ricompense, ma\ndovrai combattere, lottare e faticare.\nLe tue abilit&agrave; ti daranno saggezza, ma\ntutto ci&ograve; non sar&agrave; comunque sufficiente."
*key = 39
*value = "Per rendere il tutto ancora pi&ugrave; arduo\nspiega le tue ali\ne alzati in volo\nper solcare i cieli di questo mondo."
*key = 40
*value = "Il tesoro attende di essere portato\nalla luce, ma chi sapr&agrave; svelarlo?\nI nemici stanno cercando,\nma tu non ti farai sconfiggere."
*key = 41
*value = "Fuori da un sacro scrigno\nqueste anime senza speranza sono\nintrappolate. Se saprai trovare\nle sei giare, un cuore rivelerai."
*key = 42
*value = "Un cuore di Wraith troverai\ne tuo dovrai farlo:\ntrova quelli d'oro\nin queste terre di avventura."
*key = 43
*value = "Gli artigli della morte, tu scoprirai,\nin questa odissea.\nQuando avrai imparato a planare\ncerca il tuo tesoro."
*key = 44
*value = "In queste misteriose terre\ndovrai affrontare un'ardua prova:\nconquistane sei in questo mondo e scopri\nche non &egrave; stato tutto vano."
*key = 45
*value = "Il portale sta chiamando, i suoi meridiani\nsegnano il tempo, oltre il passaggio\nti attendono nuove avventure: perdere\nl'occasione sarebbe uno sciocco errore."
*key = 46
*value = "Oltre l'oscura ora\nti attende un misterioso nemico\nper sfruttare ogni tuo potere,\nper batterti in una dura gara."
*key = 47
*value = "Un antico monolito\nsi stende come una torre verso il sole.\nSvela il suo segreto\nse vuoi mettere fuori uso le sue bocche di fuoco."
*key = 48
*value = "Dopo esserti infiltrato\nnella base del nemico\npotrai alterare il corso del destino\nche si nasconde in questo luogo sacro."
*key = 49
*value = "Affronta tutti i pericoli che ti\nattendono per dominare le tue paure.\nConquista un cuore se questa\nmissione non &egrave; troppo ardua per te."
*key = 50
*value = "La mente della macchina\nin cui meccanismi e pistoni stridono.\nDovrai essere veloce e astuto\no il tuo destino sar&agrave; davvero orribile."
*key = 51
*value = "Un monumento da costruire,\nuna colossale missione:\nper ottenere la tua ricompensa\ndevi portare a termine il tuo dovere."
*key = 52
*value = "La dama del lago\nconosce la strada.\nUn sentiero attraverso gli anelli\npotr&agrave; finalmente risvegliarla."
*key = 53
*value = "I resti di questi defunti\nsono disseminati ovunque.\nCerca le teste\nper svelare il tesoro."
*key = 54
*value = "Orribili orde rosse\ncercheranno di precederti.\nTroverai aiuto, si narra,\nsolo nel possesso dei cuori."
*key = 55
*value = "Ebano e avorio\ne ogni colore tra questi.\nDissonanza e armonia come in\nun adagio per piano."
*key = 56
*value = "Il tempo non attende nessuno.\nIl duro lavoro &egrave; sofferenza,\nquindi affronta il sole\ne scopri dove si cela la ricompensa."
*key = 57
*value = "Se saprai giocare con correttezza,\nnonostante tu sia piccolo\nriuscirai ad avere la meglio\nin questo gioco d'azione."
*key = 58
*value = "Una pericolosa pendice di ghiaccio,\nle ombre della montagna celano.\nNon devi conoscere paura\nper trovare il tesoro nascosto."
*key = 59
*value = "Su un candeliere\nsono intrappolati questi poveri spiriti.\nPer far apparire il cuore\nlascia che siano i tuoi passi a condurti."
*key = 60
*value = "Tutte quelle blu\nsvolgono la stessa funzione\nmentre quelle di altre tonalit&agrave;\nsi stanno trasformando in un cuore di Wraith."
*key = 61
*value = "Un isolotto serpeggia nel cielo\noltre l'artiglio pi&ugrave; grande.\nLass&ugrave; trova il tuo tesoro\ntra le fauci dei Talon."
*key = 62
*value = "Cerca l'artiglio spezzato\ne giungi sino alla cima.\nTroverai battaglia ad attenderti\ne i deboli non sopravvivranno."
*key = 63
*value = "Un allampanato babbeo\nti prender&agrave; per folle\ne per ottenere il suo tesoro\ndovrai cercare il gioiello di famiglia."
*key = 64
*value = "Segui un sentiero clandestino\ne non abbandonarlo mai.\nEvita gli attacchi nemici\nper veder apparire uno dei cuori."
*key = 65
*value = "Attorno alle spire dei Talon\nc'&egrave; una giara dell'anima,\nma se le tue ali cederanno\rovinerai a terra."
*key = 66
*value = "Un cuore di Wraith troverai\ne tuo dovrai farlo:\ntrova quelli d'oro\nin queste terre di avventura."
*key = 67
*value = "Un'isola sola nello spazio\noltre la quale dovrai scalare\ne cos&igrave; il cuore trovare.\n&Eacute; solo una questione di tempo."
*key = 68
*value = "Un cuore &egrave; custodito in cattivit&agrave;\ne per liberarlo dovrai soffrire.\nIl tuo obiettivo pu&ograve; variare,\nma il tuo compito sempre arduo rimarr&agrave;."
*key = 69
*value = "Il portale sta chiamando, i suoi meridiani\nsegnano il tempo, oltre il passaggio\nti attendono nuove avventure: perdere\nl'occasione sarebbe uno sciocco errore."
*key = 70
*value = "Oltre l'oscura ora\nti attende un misterioso nemico\nper sfruttare ogni tuo potere,\nper batterti in una dura gara."
*key = 71
*value = "In queste misteriose terre\ndovrai affrontare un'ardua prova:\nconquistane sei in questo mondo e scopri\nche non &egrave; stato tutto vano."
*key = 72
*value = "La roccia della montagna e il corallo\nfaranno da cornice al tuo volo errante.\nRisolvi l'enigma\nuna volta vista la luce."
*key = 73
*value = "Quando una 'X' ne segna il punto\negli scatter&agrave; fuori dal proprio covo.\nTempesta, abisso e terrore\nti condurranno a un grande tesoro."
*key = 74
*value = "Se ci&ograve; che maggiormente desideri &egrave; un cuore\ncerca di non allontanarti dalla tua avventura:\npericolosi pesci\ndovrai ammansire!"
*key = 75
*value = "Giace nella desolazione\ne pare l'unica tua speranza\ndi raggiungere il luogo che brami,\nma prima lo devi sorvegliare."
*key = 76
*value = "Uno strano veicolo d'acqua\nti attande per una gara.\nSegui il tracciato\ne concludi da vincitore."
*key = 77
*value = "Celate in un oscuro covo\nfluttuano nelle profondit&agrave; le giare delle anime.\nLa loro malvagia presenza\nnelle profondit&agrave; del pozzo ti trasciner&agrave;."
*key = 78
*value = "Orribili orde rosse\ncercheranno di precederti.\nTroverai aiuto, si narra,\nsolo nel possesso dei cuori."
*key = 79
*value = "In una torre si cela un cuore\nche sembra cos&igrave; semplice da liberare,\sebbene dovrai sfruttare tutte le tue abilit&agrave;\nper riuscire a superare questa prova di gravit&agrave;."
*key = 80
*value = "Una volta liberato il tesoro\ntrattenuto dale onde\nforse riuscirai a cavalcare la scia\ndei brillanti raggi."
*key = 81
*value = "In ognuna delle torri d'acqua\ntroverai una sfida.\nOtterrai un tesoro di grande potere\nquando saprai dare la giusta risposta.\"
*key = 82
*value = "La torre centrale cela\nun secondo ingresso.\nUna sfida ti attende all'interno,\nun velocissimo giro di anelli."
*key = 83
*value = "Queste giare delle anime sono bloccate\nall'interno di sei mulinelli.\nSommerse o sulla terra,\ntu dovrai usare tutti i mezzi a tua disposizione."
*key = 84
*value = "Tutte quelle blu\nsvolgono la stessa funzione\nmentre quelle di altre tonalit&agrave;\nsi stanno trasformando in un cuore di Wraith."
*key = 85
*value = "Una imponente struttura si staglia\naccanto alla idrocentrale.\nUn passo errato e sar&agrave; la tua fine, a meno\nche le tue abilit&agrave; non siano davvero grandi."
*key = 86
*value = "Una estenuante sfida ti attende\npresso l'estuario.\nUsa tutte le tue abilit&agrave;\nper superare questa missione."
*key = 87
*value = "All'interno del tempio pi&ugrave; lontano\nun malvagio chiede rivincita.\nLe sue mosse ormai le conosci.\nOra affrontalo."
*key = 88
*value = "In una bolla\npotrai essere alterato\nin modo da poter risolvere\nstrane situazioni."
*key = 89
*value = "Lungo un sentiero\nsi celano queste anime disperate.\nPer rimandare indietro gli spiriti\nliberali dalle loro bolle."
*key = 90
*value = "Un cuore di Wraith troverai\ne tuo dovrai farlo:\ntrova quelli d'oro\nin queste terre di avventura."
*key = 91
*value = "L'ombelico della bestia\npotrebbe rivelarsi una tomba d'acqua.\nLa chiave della vittoria\nsi cela sotterrata da qualche parte."
*key = 92
*value = "All'interno di particolari spire,\nmentre muovi la mano,\npotrai trovare l'accesso\nal castello di sabbia."
*key = 93
*value = "Il portale sta chiamando, i suoi meridiani\nsegnano il tempo, oltre il passaggio\nti attendono nuove avventure: perdere\nl'occasione sarebbe uno sciocco errore."
*key = 94
*value = "Oltre l'oscura ora\nti attende un misterioso nemico\nper sfruttare ogni tuo potere,\nper batterti in una dura gara."
*key = 95
*value = "In queste misteriose terre\ndovrai affrontare un'ardua prova:\nconquistane sei in questo mondo e scopri\nche non &egrave; stato tutto vano."
*key = 96
*value = "In un lago di montagna\ntroverai una misteriosa pozza\nin cui un solitario pesce ti attende\nper darti ancora un insegnamento."
*key = 97
*value = "Il fuoco della montagna sfavilla\nsu di uno sporco sentiero.\nUn puntino rosso che corre veloce\nverso il cuore di Wraith che tu hai mancato."
*key = 98
*value = "Nel profondo del pozzo del male\nattraverso malsani vapori\nper raggiungere la cima dell'inferno\ne trovare il cuore che attende di essere redento."
*key = 99
*value = "In un mare di fiamme\nun vascello fantasma fluttua.\nA bordo troverai una sfida i cui\ncolori sono importanti per la riuscita."
*key = 100
*value = "In una bocca di fuoco\n&egrave; giunto il tempo della resa\nnei pressi di uno dei punti della bussola."
*key = 101
*value = "Risplende il calore della lava,\nin essa le giare fluttuano e affondano.\nAccanto al punto pi&ugrave; infuocato\troverai una grande ricompensa."
*key = 102
*value = "Orribili orde rosse\ncercheranno di precederti.\nTroverai aiuto, si narra,\nsolo nel possesso dei cuori."
*key = 103
*value = "Se riuscirai a trovare il tuo tesoro\nsarai riuscito a raggiungere il tuo obiettivo.\nQuindi raccogli tutte le tue forze\ne supera ancora questo ostacolo."
*key = 104
*value = "Una mortale sfida ha avuto inizio\nall'interno di una oscura cripta\ndove le sentinelle mirano mortalmente\ne sparano a chiunque a vista."
*key = 105
*value = "Prendi nota dei simboli che hai trovato\nin giro e premi\nil pulsante A\vicino a un diorama."
*key = 106
*value = "Nel pirosseo,\noltre una porta segreta,\npotrai trovare un cuore da liberare\n… baster&agrave; usare un po' di ingegno."
*key = 107
*value = "Nel vortice delle fiamme\nqueste anime intrappolate vagano\nantiche e senza nome\naspettando solo di essere trovate."
*key = 108
*value = "Tutte quelle blu\nsvolgono la stessa funzione\nmentre quelle di altre tonalit&agrave;\nsi stanno trasformando in un cuore di Wraith."
*key = 109
*value = "File di pilastri si stagliano\nopponendosi alla fase,\nun enigma da risolvere\nuna risposta da trovare."
*key = 110
*value = "La vetta della grande piramide\nrivela un cuore di Wraith.\nSe &egrave; ci&ograve; che cerchi\nscorpi lo schema della piramide."
*key = 111
*value = "Una corsa nella fresca aria.\nCompi questo viaggio\ne troverai ad attenderti un premio\nsulla cime di questa piramide."
*key = 112
*value = "Hai affrontato una mummia,\nma ora essa chiede una rivincita.\nL'arena &egrave; pronta,\nora combatti."
*key = 113
*value = "La mano di un gigante silenzioso\nrivela un cubo magico.\nUn enigma esso cela\nche tu dovrai risolvere."
*key = 114
*value = "Un cuore di Wraith troverai\ne tuo dovrai farlo:\ntrova quelli d'oro\nin queste terre di avventura."
*key = 115
*value = "Oltre i flutti della lava\nla tua carne non &egrave; alsicuro.\nMa non arrenderti\ne la soluzione cadr&agrave; dal cielo."
*key = 116
*value = "Tra le fiamme dell'inferno\nun mondo sotterraneo\nti rivela una via di fuga.\nMa dovrai essere veloce."
*key = 117
*value = "Il portale sta chiamando, i suoi meridiani\nsegnano il tempo, oltre il passaggio\nti attendono nuove avventure: perdere\nl'occasione sarebbe uno sciocco errore."
*key = 118
*value = "Oltre l'oscura ora\nti attende un misterioso nemico\nper sfruttare ogni tuo potere,\nper batterti in una dura gara."
*key = 119
*value = "In queste misteriose terre\ndovrai affrontare un'ardua prova:\nconquistane sei in questo mondo e scopri\nche non &egrave; stato tutto vano."
*key = 120
*value = "Alcume palme riverse\nfanno eco.\nIl segreto che celano\nsveler&agrave; un fratello sotterraneo."
*key = 121
*value = "Un antico mulino\nmesso in movimento dal vento\nti condurr&agrave; in cima ai ghiacci,\noppure sino alla morte."
*key = 122
*value = "Attraversa il muro di vento\ne accedi a questo luogo.\nMa non cadere,\no non riuscirai a sopravvivere."
*key = 123
*value = "All'interno delle pareti dell'igloo\nun cuore attende tre chiavi.\nSe verrai assalito dalle palle di neve,\nprova a sfruttarle per i tuoi fini."
*key = 124
*value = "un labirinto di ghiaccio,\nun tesoro tra le sue mura.\nSe provi ad abbatterli\ngli ostacoli potrebbero cedere."
*key = 125
*value = "Queste giare delle anime sono intrappolate\ne in un vascello troverai la chiave\nper liberarle.\nUsa le armi pesanti."
*key = 126
*value = "Orribili orde rosse\ncercheranno di precederti.\nTroverai aiuto, si narra,\nsolo nel possesso dei cuori."
*key = 127
*value = "Il goffo lo avevi gi&agrave; incontrato,\nma questa volte le cose sono diverse.\nSbarazzatene\ne otterrai il suo cuore."
*key = 128
*value = "Attraverso le mortali spume dell'acqua\nsi cela un passaggio per la torre.\nUsa tutte le tue abilit&agrave; di nuoto\ne ottieni del potere extra."
*key = 129
*value = "Trova tra le ventose cime\nl'entrata all'arena.\nAcora una volta, attacca i tuoi nemici\ne avrai tu la meglio."
*key = 130
*value = "Raggiungi la cima innevata\ne fai attenzione ai tuoi passi.\nIl tesoro che cerchi\nsi trova proprio sul ghiacciaio."
*key = 131
*value = "Attraverso le cime innevate,\na un'altezza davvero impressionante,\nci sono i vascelli delle anime perdute\nche attendono di essere liberate."
*key = 132
*value = "Tutte quelle blu\nsvolgono la stessa funzione\nmentre quelle di altre tonalit&agrave;\nsi stanno trasformando in un cuore di Wraith."
*key = 133
*value = "Usa tutte le abilit&agrave; che hai appreso\nper raccogliere preziosi oggetti.\nUna volta trovati potrai rimettere in\nmovimento il congegno degli anelli."
*key = 134
*value = "Lungo un nuovo sentiero\nun cuore di Wraith troverai.\nSopravvivi agli attacchi\ne sventa cos&igrave; i piani degli Wraith."
*key = 135
*value = "Attraversa il mortale cammino\ne giungi al pozzo\nche cela un ultimo cuore\nin grado di dare potenza ai reattori."
*key = 136
*value = "Il vile cuore della fortezza\ncela un oscuro segreto.\nIl suo bagliore ti aiuter&agrave;\na superare anche questa difficolt&agrave;."
*key = 137
*value = "Tra gli anelli del motore,\nle sei giare delle anime troverai.\nPer conquistare questi preziosi tesori\ndovrai coordinare ogni tua mossa."
