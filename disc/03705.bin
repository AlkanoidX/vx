$\Data\Text\ADDENDUM2.txm*key = 0
*value = "Reserved"
*key = 1
*value = "&iexcl;&iexcl;Bienvenido a Timberdale, Vexx!! Esparcidos en esta tierra hay cuatro preciosos corazones tenebrosos. Debes recogerlos para fortalecer la puerta central y avanzar al siguiente mundo"
*key = 2
*value = "El primer coraz&oacute;n tenebroso est&aacute; aqu&iacute;. Debes escalar hasta lo m&aacute;s alto del &aacute;rbol gigante para recogerlo."
*key = 3
*value = "Enfr&eacute;ntate al luchador de sumo, para conseguir el coraz&oacute;n tenebroso que posee"
*key = 4
*value = "Escala las rocas giratororias para recoger este coraz&oacute;n tenebroso."
*key = 5
*value = "Asciende por la catarata para conseguir este coraz&oacute;n tenebroso."
*key = 6
*value = "Vexx, recoge uno de los corazones tenebrosos quedamos al otro lado de la Puerta Central.&iexcl;&iexcl;&iexcl; Suerte, amigo!!"
*key = 7
*value = "Los PAREDES DE ESCALADA est&aacute;n grabados con marcas &uacute;nicas. <pause>SALTA hacia el Muro de Escalada para empezar a escalar . <pause>Mueve hAcia arriba tu THUMBSTICK izquierdo y pulsa el bot&oacute;n de salto para avanzar m&aacute;s r&aacute;pido. <pause>Suelta el bot&oacute;n de salto para agarrarte al muro mientras escalas. <pause> Pulsa el bot&oacute;n de salto sin ir hacia ninguna direcci&oacute;n para salar lejos del muro. <pause>Pulsa el bot&oacute;n de ataque para soltarte del muro."
*key = 8
*value = "Mueve el STICK derecho para mpver la c&aacute;mar alrededor de Vexx. <pause>Pulsa el STICK derecho para hacer un zoom con la c&aacute;mara."
*key = 9
*value = "Pulsa START en cualquier momento para ver las pistas de los corazones tenebrosos."
*key = 10
*value = "Haz un SALTO DE PULSO para ganar altura extra. <pause>Cuando estes parado manten pulsado el gatillo izquierdo para agacharte,seguido del bot&oacute;n de salto."
*key = 11
*value = "HaZ un ATAQUE DE GANCHO para lanzar a los enemigos por loa aires. <pause> Cuando estes parado manten pulsado el gatillo izquierdo para agacharte,seguido del bot&oacute;n de ataque"
*key = 12
*value = "Haz un SALTO LARGO para ganar distancia extra .Mientras corres pulsa el gatillo izquierdo para impulsarte, seguido inmediatamente del bot&oacute;n de salto. <pause>&iexcl;La clave est&aacute; en la rapidez!"
*key = 13
*value = "Echa del ring al gigante del sumo para ganar.<pause>Ten cuidado con su ATAQUE DE EMBESTIDA!"
*key = 14
*value = "Logra hacer marabares a&eacute;reos con tus enemigos para conseguir bonus."
*key = 15
*value = "&iexcl;Bien Hecho Vexx!. Has recogido 100 fragmentos.Su  energia combinada se ha transformado en un coraz&oacute;n tenebroso"
*key = 16
*value = "Vexx"
*key = 17
*value = "Sumo"
*key = 18
*value = "&iexcl;Bien Hecho Vexx! Has encontrado uno de los portales ocultos del reloj de sol. Encuentra el coraz&oacute;n tenebroso oculto en &eacute;l."
*key = 19
*value = "&iexcl;Bien Hecho Vexx! Has liberado 6 almas Astani de sus jarras espirituales . Un Coraz&oacute;n Tenebroso se ha desplegado."
*key = 20
*value = "&iexcl;Bien Hecho Vexx! Has recogido 6 SIGILS. Un Coraz&oacute;n Tenebroso se ha liberado"
*key = 21
*value = " Acabas de conseguir un de los 6 SIGILS. Recogelos para liberar un Coraz&oacute;n Tenebroso."
*key = 22
*value = "A la hora oculta. <pause>Un doppleganger espera. <pause>Para usar cada uno de tus poderes. <pause>Para derrotarte en una carrera"
*key = 0
*value = "Reserved"
*key = 1
*value = "Si caes desde gran altura usa la Patada Cuchilla para evitar da&ntilde;arte cuando caigas al suelo."
*key = 2
*value = " Si quieres volver de forma f&aacute;ci,t&iacute;rate a la plataforma de abajo y usa el teletransportador."
*key = 3
*value = "Cuando ataques a los enemigos, intenta utilizar marabares para incrementar tus oportunidades de conseguir tiestos, energia y vidas extra."
*key = 4
*value = "El MagnaSliph es una mortal criatura del desierto. Usa los elevadores para evitar ser absorbida por esta enorme bestia."
*key = 5
*value = "Se dice que no todos los enemigos tienen malas Intenciones. Espera aqu&iacute; y ver&aacute;s"
*key = 6
*value = "&iexcl;FELICIDADES! Has ganado el powerup del aire Ahora ser&aacute;s capaz de planear usando las plataformas de vuelo amarillas"
*key = 7
*value = "Ay&uacute;dame... despeja este lugar, por favor"
*key = 8
*value = "Gracias. Aqu&iacute; tienes algo para t&iacute;"
