*key = 0
*value = "Reserved"
*key = 1
*value = "<available>"
*key = 2
*value = "Esegui degli AIR JUGGLE sul nemico per ottenere dei bonus. <pause>Esegui un ATTACCO UPPERCUT sul nemico per dare inizio a un AIR JUGGLE. <pause>Pu&ograve; essere subito seguito da un CALCIO ROTANTE!"
*key = 3
*value = "Oltre l'oscura ora ti attende un misterioso nemico per sfruttare ogni tuo potere, per batterti in una dura gara."
*key = 4
*value = "Questa &egrave; una MERIDIANA. Saltaci sopra per cambiare l'ora del giorno!"
*key = 5
*value = "Hai appena trovato una delle 6 GIARE DELL'ANIMA. Raccoglile tutte per rivelare un CUORE DI WRAITH."
*key = 6
*value = "Diario di\nReia"
*key = 7
*value = "Totale\ncuori"
*key = 8
*value = "Cuore"
*key = 9
*value = "I PUGGLE sono dei piccoli esserini malefici, che per&ograve; di GIORNO non rappresentano un vero e proprio pericolo. Cerca di scaraventarli in aria per ottenere dei bonus entra e fai molta attenzione a loro di NOTTE!"
*key = 10
*value = "I GRIMKIN sono viscidi e forti spiriti scheletri. Sono veloci e possono CONTROBATTERE i tuoi attacchi."
*key = 11
*value = "Gli SKINX dei rompiscatole volanti che attenderanno fino a quando non potranno essere sicuri di colpirti con una rapida PUGNALATA. Mettili fuori combattimento con un UPPERCUT o con un CALCIO ROTANTE."
*key = 12
*value = "Gli ABSCONX cercheranno di AIUTARTI, oppure di scagliarti nella tomba, ma non potrai saperlo fino all'ultimo. Muovi la levetta analogica sinistra  e destra per LIBERARTI quando cercano di COLPIRTI."
