$\Data\Text\ADDENDUM2.txm*key = 0
*value = "Reserviert"
*key = 1
*value = "Willkommen in Timberdale, Vexx! In diesem Land sind vier kostbare GEISTERHERZEN verstreut. Diese brauchstdu, um das ZENTRALTOR zu aktivieren und in das n&auml;chste Land zu gelangen."
*key = 2
*value = "Hier findest du das erste GEISTERHERZ. Dazu musst du die Spitze des Riesenbaums erklimmen."
*key = 3
*value = "K&auml;mpfe mit dem Riesen-Sumo-Boss um dieses GEISTERHERZ."
*key = 4
*value = "Erklettere die Wirbelnden Felsen, wenn du dir dieses GEISTERHERZ holen willst."
*key = 5
*value = "Nutze die Plattformen in den Wasserf&auml;llen, um an dieses GEISTERHERZ zu gelangen."
*key = 6
*value = "Vexx, hole dir eins der GEISTERHERZEN; ich treffe dich jenseits des ZENTRALTORES. Viel Gl&uuml;ck, mein Freund!"
*key = 7
*value = "Eingraviert in KLETTERW&Auml;NDE findest du besondere Zeichen. <pause>SPRING an eine KLETTERWAND, wenn du sie erklettern willst. <pause>Bewege dich mit dem MINISTICK LINKS nach OBEN und dr&uuml;cke die SPRUNG-Taste, wenn du Tempo zulegen willst. <pause>Lass die SPRUNG-Taste los, wenn du dich beim Klettern an die Wand krallen willst. <pause>Dr&uuml;ck die SPRUNG-Taste, ohne den Ministick links in eine bestimmte Richtung zu bewegen, um von der Wand wegzuspringen. <pause>Dr&uuml;ck die ANGRIFF-Taste, um die Wand loszulassen."
*key = 8
*value = "Bewege den MINISTICK RECHTS, um die Kamera um Vexx herum zu bewegen. <pause>Klicke den RECHTEN MINISTICK, um zu zoomen."
*key = 9
*value = "Du kannst dir deine GEISTERHERZ-Hinweise jederzeit anzeigen lassen, wenn du START dr&uuml;ckst."
*key = 10
*value = "Wenn du SCHNELL MEHRMALS HINTEREINANDER auf die SPRUNG-Taste dr&uuml;ckst, gewinnst du zus&auml;tzliche H&ouml;he. <pause>Willst du in die Hocke gehen, dann dr&uuml;cke den LINKEN SCHALTER, wenn du still stehst, und halte ihn gedr&uuml;ckt, dr&uuml;cke dann die SPRUNG-Taste ."
*key = 11
*value = "F&uuml;hre einen AUFW&Auml;RTSHAKEN-ANGRIFF aus, wenn du Gegner in die Luft schleudern willst. <pause>Dr&uuml;cke dazu, wenn du still stehst, den LINKEN SCHALTER und halte ihn gedr&uuml;ckt, um in die Hocke zu gehen, und dr&uuml;cke dann die ANGRIFF-Taste."
*key = 12
*value = "Ein WEITSPRUNG bringt dich noch ein St&uuml;ck weiter. Dr&uuml;cke dazu im Laufen den LINKEN SCHALTER, um in die Hocke zu gehen, und dr&uuml;cke dann sofort die SPRUNG-Taste. <pause>Auf das richtige Timing kommt es an!"
*key = 13
*value = "Schlage den Riesen-Sumo dreimal aus dem Ring, um zu gewinnen. <pause>Sei auf seinen SPRUNG-ANGRIFF gefasst!"
*key = 14
*value = "JONGLIERE ein paarmal hintereinander mit den Gegnern, wenn du dir einen zus&auml;tzlichen Bonus holen willst."
*key = 15
*value = "Gut gemacht, Vexx! Du hast 100 BLUTROTE SCHERBEN gesammelt. Ihre Energie zusammengenommen hat dieses GEISTERHERZ enth&uuml;llt."
*key = 16
*value = "Vexx"
*key = 17
*value = "Sumo"
*key = 18
*value = "Gut gemacht, Vexx! Du hast einen der geheimen Sonnenuhrportal-Level gefunden. Hier ist ein weiteres GEISTERHERZ versteckt."
*key = 19
*value = "Gut gemacht, Vexx! Du hast die 6 Astani-Seelen aus ihren Seelengef&auml;ssen befreit. Ein GEISTERHERZ wird enth&uuml;llt."
*key = 20
*value = "Gut gemacht, Vexx! Du hast die 6 SIGILS gefunden. Ein GEISTERHERZ wird enth&uuml;llt."
*key = 21
*value = "Du hast soeben eines der 6 SIGILS gefunden. Wenn du alle findest, gewinnst du ein weiteres GEISTERHERZ."
*key = 22
*value = "Zu dunkler, verborgener Stunde. <pause>Tritt ein Doppelg&auml;nger in die Runde. <pause>Deine Kr&auml;fte konnt' er kriegen. <pause>Will im Rennen dich besiegen."
*key = 0
*value = "Reserviert"
*key = 1
*value = "Wenn du aus grosser H&ouml;he f&auml;llst, f&uuml;hre einen Bladekick aus, bevor du auf dem Boden aufkommst, um dich nicht zu verletzen"
*key = 2
*value = "Wenn du dir den R&uuml;ckweg leichter machen willst, lass dich auf die Plattform unten fallen und verwende das Teleporter-Feld"
*key = 3
*value = "Versuche, beim Angriff den Gegner zu jonglieren, damit verbesserst du deine Chancen auf Scherben, Gesundheit und zus&auml;tzliche M&auml;nner"
*key = 4
*value = "Der MagnaSliph ist eine t&ouml;dliche W&uuml;stenkreatur. Benutze die Aufz&uuml;ge, wenn du nicht von diesem riesigen Tier verschlungen werden willst."
*key = 5
*value = "Es heisst, nicht alle Gegner beabsichtigten B&ouml;ses. Warte einfach hier ab und schau's dir an."
*key = 6
*value = "GL&Uuml;CKWUNSCH!! Du hast den Schwebe-Powerup gewonnen!! Jetzt kannst du mit den Gelben Flug-Feldern vor&uuml;bergehend durch die Luft gleiten."
*key = 7
*value = "Bitte hilf mir, hier aufzur&auml;umen!"
*key = 8
*value = "Danke!! Komm mal her, ich hab hier was f&uuml;r dich."
*key = 9
*value = "[verf&uuml;gbar]"
*key = 10
*value = "[verf&uuml;gbar]"
*key = 0
*value = "Reserviert"
*key = 1
*value = "Auf diesem rutschigen Boden wirst du nicht weit kommen, Vexx... <pause> ausser vielleicht in einen Backofen!"
*key = 2
*value = "Du hast gewonnen!"
*key = 3
*value = "Zu langsam, versuch's nochmal!"
*key = 4
*value = "Start!"
*key = 5
*value = "[verf&uuml;gbar]"
*key = 6
*value = "[verf&uuml;gbar]"
*key = 7
*value = "[verf&uuml;gbar]"
*key = 8
*value = "[verf&uuml;gbar]"
*key = 9
*value = "[verf&uuml;gbar]"
*key = 10
*value = "[verf&uuml;gbar]"
*key = 0
*value = "Reserviert"
*key = 1
*value = "nicht verf&uuml;gbar"
*key = 2
*value = "Dr&uuml;cke X, um in die Waldwelt zu gelangen, oder A f&uuml;r Abbruch."
*key = 3
*value = "GL&Uuml;CKWUNSCH! Mit diesen 5 Herzen h&auml;ttest du ein weiteres Gebiet freigeschaltet."
*key = 4
*value = "Wir sind scharf auf die Beute aus der Schatztruhe hier. Wenn du sie nicht f&uuml;r uns aufkriegst, fliegst du achtkantig aus dem Ausgangsloch!"
*key = 5
*value = "Arrgh! Da is' ja gar kein Gold in der Truhe!"
*key = 6
*value = "Dr&uuml;cke die richtige Taste f&uuml;r jedes Schloss."
*key = 7
*value = "Dr&uuml;cke die richtige Taste, um Schloss 2 aufzuschliessen."
*key = 8
*value = "Dr&uuml;cke die richtige Taste, um Schloss 3 aufzuschliessen."
*key = 9
*value = "Falsche Kombination."
*key = 10
*value = "Ich will endlich ran an die Kohle! Also mal 'n bisschen dalli mit der Kombination."
*key = 11
*value = "Was ist denn in der Kiste?!?!"
*key = 12
*value = "Du bist echt DER HAMMER!"
*key = 13
*value = "Dieb! Wir hassen es. Wir hassen es auf ewig!"
*key = 14
*value = "Zeig's mir, zeig's mir, zeig mir, wie du das hingekriegt hast."
*key = 15
*value = "Auch du kannst mit der R&ouml;hrentechnik zwischen den oberen und den unteren Inseln verkehren. Spring einfach in das Loch."
*key = 16
*value = "Der Leuchtturm kann erst betreten werden, wenn er vollst&auml;ndig ausgefahren ist."
*key = 17
*value = "Vorsicht, bevor du dich dem Stromf&uuml;hrenden Quanten-Ballistik-Oszillator n&auml;herst,<pause>musst du zun&auml;chst ein Quanteninterferenzph&auml;nomen analog zu dem elektrostatischen Janda-Ong-Effekt in den ballistischen Nanostrukturen ausl&ouml;sen. <pause>Oder anders ausgedr&uuml;ckt, dr&uuml;ck eine Taste, um den Strahl auszuschalten."
*key = 18
*value = "Insgesamt sind hier sechs Blasen mit Seelengef&auml;sse verborgen."
*key = 19
*value = "Die Schwachstelle des Sumoringers liegt in seinem R&uuml;cken."
*key = 20
*value = "Rennen ist nicht die schnellste Methode, um vom Fleck zu kommen."
*key = 21
*value = "Suche nach grossen spiegelnden Blasen, um unter Wasser deine Sauerstoffvorr&auml;te wieder aufzuf&uuml;llen."
*key = 22
*value = "Draussen ist ein Geisterherz enth&uuml;llt worden!"
*key = 0
*value = "Reserviert"
*key = 1
*value = "Bist du so lahm wie du aussiehst? Wie w&auml;r's mit einem Wettrennen?  <3> Ja  <2> Nein <respond 2 3"
*key = 2
*value = "Dachte ich's mir doch, du hast keine Chance gegen mich!"
*key = 3
*value = "Wir sehen uns am Ziel, wenn du's &uuml;berhaupt so weit schaffst!"
*key = 4
*value = "Dieses Feld bringt dich zum Eingang der Pyramide."
*key = 5
*value = "Wow! Du bist fixer als ich dachte.  Hier ist deine Belohnung!"
*key = 6
*value = "[verf&uuml;gbar]"
*key = 7
*value = "[verf&uuml;gbar]"
*key = 8
*value = "[verf&uuml;gbar]"
*key = 9
*value = "[verf&uuml;gbar]"
*key = 10
*value = "[verf&uuml;gbar]"
*key = 0
*value = "Reserviert"
*key = 1
*value = "Pass auf! Starke Winde wehen &uuml;ber die Br&uuml;cke. Auf das richtige Timing kommt es an!"
*key = 2
*value = "<10>-Taste halten, um die Reisegeschwindigkeit zu erh&ouml;hen."
