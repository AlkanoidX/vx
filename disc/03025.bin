*key = 6
*value = "Vexx, collect one of the WRAITHHEARTS and I'll meet you on the other side of the CENTRAL GATE. Good luck, my friend!"
*key = 7
*value = "CLIMBING WALLS are engraved with unique markings. <pause>JUMP onto a CLIMBING WALL to start climbing. <pause>Move UP on the LEFT THUMBSTICK and press the JUMP button to scale climbing walls quicker. <pause>Release the JUMP button to grab onto wall when scaling. <pause>Press the JUMP button with no left thumbstick direction to jump away from the wall. <pause>Press the ATTACK button to release from the wall."
*key = 8
*value = "Move the RIGHT <11> to move the camera around Vexx."
*key = 9
*value = "Press START at any time to view your WRAITHHEART clues."
*key = 10
*value = "Perform a PULSE JUMP to gain extra height. <pause>When stationary, hold <9> to crouch, followed by the <3> button."
*key = 11
*value = "Perform an UPPERCUT ATTACK to send enemies into the air. <pause>When stationary, hold <9> to crouch, followed by the <4> button."
*key = 12
*value = "Perform a LONG JUMP to gain extra distance. <pause>While running, press <9> to crouch, immediately followed by the <3> button. <pause>Timing is the key!"
*key = 13
*value = "Knock the Giant Sumo out of the ring 3 times to win. <pause>Watch out for his LUNGE ATTACK!"
